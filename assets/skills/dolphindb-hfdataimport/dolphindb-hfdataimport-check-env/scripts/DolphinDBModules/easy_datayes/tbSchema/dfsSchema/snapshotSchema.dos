module easy_datayes::tbSchema::dfsSchema::snapshotSchema

/*
 * @FunctionName: snapshotSchemaTb
 * @Brief: Defines the schema for the snapshot data table (61 fields, merged Shanghai and Shenzhen markets).
 * @Return: A table schema defining the structure of the snapshot data table.
 */
def snapshotSchemaTb(){
	schemaTable = table(
		array(SYMBOL, 0) as code,
		array(SYMBOL, 0) as exchange,
		array(DATE, 0) as trade_date,
		array(TIME, 0) as trade_time,
		array(DOUBLE, 0) as pre_close,
		array(DOUBLE, 0) as open_price,
		array(DOUBLE, 0) as high_price,
		array(DOUBLE, 0) as low_price,
		array(DOUBLE, 0) as last_price,
		array(DOUBLE, 0) as price_up,
		array(DOUBLE, 0) as price_down,
		array(DOUBLE, 0) as dif_price1,
		array(DOUBLE, 0) as dif_price2,
		array(DOUBLE, 0) as close_price,
		array(INT, 0) as total_num,
		array(LONG, 0) as total_qty,
		array(DOUBLE, 0) as total_amt,
		array(DOUBLE, 0) as peratio1,
		array(DOUBLE, 0) as peratio2,
		array(INT, 0) as sell_level_num,
		array(LONG, 0) as total_sell_qty,
		array(DOUBLE, 0) as wtavg_sell_price,
		array(DOUBLE[], 0) as sell_price,
		array(LONG[], 0) as sell_qty,
		array(INT[], 0) as sell_num,
		array(INT, 0) as buy_level_num,
		array(DOUBLE, 0) as total_buy_qty,
		array(DOUBLE, 0) as wtavg_buy_price,
		array(DOUBLE[], 0) as buy_price,
		array(LONG[], 0) as buy_qty,
		array(INT[], 0) as buy_num,
		array(SYMBOL, 0) as phase_code,
		array(DOUBLE, 0) as nav,
		array(DOUBLE, 0) as iopv,
		array(DOUBLE, 0) as premium_rate,
		array(INT, 0) as trade_num,
		array(LONG, 0) as trade_qty,
		array(DOUBLE, 0) as trade_amt,
		array(INT, 0) as etf_buy_num,
		array(LONG, 0) as etf_buy_qty,
		array(DOUBLE, 0) as etf_buy_amt,
		array(INT, 0) as etf_sell_num,
		array(LONG, 0) as etf_sell_qty,
		array(DOUBLE, 0) as etf_sell_amt,
		array(DOUBLE, 0) as ytm,
		array(LONG, 0) as total_buy_num,
		array(LONG, 0) as total_sell_num,
		array(INT, 0) as withdraw_buy_num,
		array(LONG, 0) as withdraw_buy_qty,
		array(DOUBLE, 0) as withdraw_buy_amt,
		array(INT, 0) as withdraw_sell_num,
		array(LONG, 0) as withdraw_sell_qty,
		array(DOUBLE, 0) as withdraw_sell_amt,
		array(DOUBLE, 0) as max_buy_duration,
		array(DOUBLE, 0) as max_sell_duration,
		array(INT, 0) as buy_order_num,
		array(INT, 0) as sell_order_num,
		array(LONG, 0) as total_warrant_exec_vol,
		array(DOUBLE, 0) as warrant_down_limit,
		array(DOUBLE, 0) as warrant_up_limit,
		array(TIMESTAMP, 0) as update_time)
	return schemaTable
}

