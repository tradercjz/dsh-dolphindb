module easy_datayes::loadData::loadOneDayData::loadOneDayTrade


/*
 * @FunctionName: transformTradeSH
 * @Brief: Transforms the trade data for the Shanghai market into a standardized format with new field names (merged market format only).
 * @Param: day: The specific trading day for which the data is being processed.
 * @Param: merge: A boolean flag (kept for compatibility, but only merged format is supported).
 * @Param: t: The input data table containing the original trade data.
 * @Return: A table containing transformed trade data with standardized field names (channel_no, appl_seq, buy_no, sell_no, code, trade_price, trade_qty, trade_date, trade_time, trade_amt, side, trade_no, trade_type, exchange, update_time).
 */
def transformTradeSH(t, day){
	// Transform to standardized format with new field names
	tmpData = select TradeChan as channel_no,
					TradeIndex as appl_seq,
					TradeBuyNo as buy_no,
					TradeSellNo as sell_no,
					SecurityID + ".SH" as code,
					TradPrice as trade_price,
					TradVolume as trade_qty,
					day as trade_date,
					TradTime as trade_time,
					TradeMoney as trade_amt,
					TradeBSFlag as side,
					cumcount(TradeIndex) as trade_no,
					string(NULL) as trade_type,
					"SH" as exchange,
					now() as update_time
				from t context by TradeChan order by TradTime
	return tmpData
}

/*
 * @FunctionName: transformTradeSZ
 * @Brief: Transforms the trade data for the Shenzhen market into a standardized format with new field names (merged market format only).
 * @Param: day: The specific trading day for which the data is being processed.
 * @Param: merge: A boolean flag (kept for compatibility, but only merged format is supported).
 * @Param: t: The input data table containing the original trade data.
 * @Return: A table containing transformed trade data with standardized field names (channel_no, appl_seq, buy_no, sell_no, code, trade_price, trade_qty, trade_date, trade_time, trade_amt, side, trade_no, trade_type, exchange, update_time).
 */
def transformTradeSZTrade(t, day){
	// Transform to standardized format with new field names based on date
	tmpData = select SetNo as channel_no,
						RecNo as appl_seq,
						BuyOrderRecNo as buy_no,
						SellOrderRecNo as sell_no,
						SecurityID + ".SZ" as code,
						Price as trade_price,
						TradeQty as trade_qty,
						day as trade_date,
						TradeTime as trade_time,
						Price * TradeQty as trade_amt,
						iif(BuyOrderRecNo > SellOrderRecNo, "B", iif(SellOrderRecNo > BuyOrderRecNo, "S", "N")) as side,
						cumcount(RecNo) as trade_no,
						OrderKind as trade_type,
						"SZ" as exchange,
						now() as update_time
					from t context by SetNo order by TradeTime
	return tmpData
}
def transformTradeSZmdl6360(t, day){
	// Transform to standardized format with new field names based on date
	tmpData = select ChannelNo as channel_no,
						ApplSeqNum as appl_seq,
						BidApplSeqNum as buy_no,
						OfferApplSeqNum as sell_no,
						SecurityID + ".SZ" as code,
						LastPx as trade_price,
						LastQty as trade_qty,
						day as trade_date,
						TransactTime as trade_time,
						LastPx * LastQty as trade_amt,
						iif(BidApplSeqNum > OfferApplSeqNum, "B", iif(OfferApplSeqNum > BidApplSeqNum, "S", "N")) as side,
						cumcount(ApplSeqNum) as trade_no,
						string(char(ExecType)) as trade_type,
						"SZ" as exchange,
						now() as update_time
					from t context by ChannelNo order by TransactTime
	return tmpData
}


