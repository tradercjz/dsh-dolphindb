    msg = stringFormat("%W", "[" + csv_zip_dir + "] Data import completed")
    msg = write_log(msg, level="info")
    update_task_status([day], ["trade"], ["SZ"], ["completed"], [""])
	// 删除解压的目录	
	try{rmdir(csv_zip_dir + "csv_temp_dir", true)}catch(ex){}

    //导入 ETF 数据
    if (is_need_etf){
        csv_zip_dir_etf = strReplace(csv_zip_dir, "STOCK", "FUND")
        load_one_day_trade_sz(csv_zip_dir_etf, day, db_name, tb_name, false)
    }
}
