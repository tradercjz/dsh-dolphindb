            one_code_tb.reorderColumns!(pt.schema().colDefs.name)
            tmp_mem_tb.append!(one_code_tb)
            if(memSize(tmp_mem_tb)\1024\1024 >= 200){
                pt.append!(tmp_mem_tb)
                tmp_mem_tb = table(1:0, pt.schema().colDefs.name, pt.schema().colDefs.typeString)
            }
        }
        pt.append!(tmp_mem_tb)
    }catch(ex){
        msg = stringFormat("%W", string(ex[0])+":"+string(ex[1]))
        msg = write_log(msg, level="error")
        update_task_status([day], ["orderqueue"], ["SZ"], ["failed"], ["Data import failed:" + string(ex[0])+":"+string(ex[1])])
        return false
    }

    msg = stringFormat("%W", "[" + csv_zip_dir + "] Data import completed")
    msg = write_log(msg, level="info")
    update_task_status([day], ["orderqueue"], ["SZ"], ["completed"], [""])
	// remove temp csv files
	try{rmdir(csv_zip_dir + "csv_temp_dir", true)}catch(ex){}

    if (is_need_etf){
        csv_zip_dir_etf = strReplace(csv_zip_dir, "STOCK", "FUND")
        load_one_day_orderqueue_sz(csv_zip_dir_etf, day, db_name, tb_name, false)
    }
}

