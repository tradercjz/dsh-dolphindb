module easy_csmar::stock::stock_csv_schema::snapshot_csv_schema
/*
*  @ brief  
*  读取csv数据到DolphinDB内存中时，强制指定schema
*/

/*
*  @FunctionName: snapshot_csv_schema_sh
*  @Brief: 上交所快照csv数据指定schema
*  @Param: day: 交易日
*  @SampleUsage: snapshot_csv_schema_sh(day=2026.05.26)
*/
def snapshot_csv_schema_sh(day){
	schema_tb = table(
		array(SYMBOL, 0) as Symbol,
		array(DATE, 0) as TradingDate,
