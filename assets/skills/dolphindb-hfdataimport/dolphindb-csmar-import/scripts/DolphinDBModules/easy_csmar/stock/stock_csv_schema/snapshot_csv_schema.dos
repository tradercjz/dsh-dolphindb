		array(DOUBLE, 0) as BuyVolume05,
		array(DOUBLE, 0) as BuyVolume06,
		array(DOUBLE, 0) as BuyVolume07,
		array(DOUBLE, 0) as BuyVolume08,
		array(DOUBLE, 0) as BuyVolume09,
		array(DOUBLE, 0) as BuyVolume10,
		array(INT, 0) as TotalNo,
		array(DOUBLE, 0) as TotalVolume,
		array(DOUBLE, 0) as TotalAmount,
		array(DOUBLE, 0) as TotalBuyOrderVolume,
		array(DOUBLE, 0) as WtAvgBuyPrice,
		array(DOUBLE, 0) as BondWtAvgBuyPrice,
		array(DOUBLE, 0) as TotalSellOrderVolume,
		array(DOUBLE, 0) as WtAvgSellPrice,
		array(DOUBLE, 0) as BondWtAvgSellPrice,
		array(DOUBLE, 0) as IOPV,
		array(DOUBLE, 0) as YTM,
		array(LONG, 0) as UNIX,
		array(SYMBOL, 0) as Market,
		array(DOUBLE, 0) as ClosePrice,
		array(INT, 0) as TotalBuyOrderNo01,
		array(INT, 0) as TotalBuyOrderNo02,
		array(INT, 0) as TotalBuyOrderNo03,
		array(INT, 0) as TotalBuyOrderNo04,
