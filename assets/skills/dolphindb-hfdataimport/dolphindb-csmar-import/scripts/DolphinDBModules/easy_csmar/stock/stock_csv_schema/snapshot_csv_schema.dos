		array(DOUBLE, 0) as BuyPrice09,
		array(DOUBLE, 0) as BuyPrice10,
		array(INT, 0) as BuyLevelNo,
		array(DOUBLE, 0) as SellVolume10,
		array(DOUBLE, 0) as SellVolume09,
		array(DOUBLE, 0) as SellVolume08,
		array(DOUBLE, 0) as SellVolume07,
		array(DOUBLE, 0) as SellVolume06,
		array(DOUBLE, 0) as SellVolume05,
		array(DOUBLE, 0) as SellVolume04,
		array(DOUBLE, 0) as SellVolume03,
		array(DOUBLE, 0) as SellVolume02,
		array(DOUBLE, 0) as SellVolume01,
