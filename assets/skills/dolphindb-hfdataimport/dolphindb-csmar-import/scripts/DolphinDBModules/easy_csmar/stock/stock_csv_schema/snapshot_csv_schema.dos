		array(INT, 0) as TotalSellOrderNo04,
		array(INT, 0) as TotalSellOrderNo05,
		array(INT, 0) as TotalSellOrderNo06,
		array(INT, 0) as TotalSellOrderNo07,
		array(INT, 0) as TotalSellOrderNo08,
		array(INT, 0) as TotalSellOrderNo09,
		array(INT, 0) as TotalSellOrderNo10,
		array(INT, 0) as ETFBuyNo,
