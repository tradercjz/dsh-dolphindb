// IMPORTANT: Before creating a distributed table, use ask_user to confirm
// the storage engine and partition scheme with the user.
// Do NOT proceed with CREATE DATABASE/TABLE without user confirmation.
// In non-interactive mode (testing platform), skip ask_user and use
// existsDatabase/existsTable conditional creation logic.

// Example: Import CSV directly to distributed table

// Step 1: Check DB/Table existence (4-branch handling)
dbPath = "dfs://stockDB"
tableName = "trades"
dbExists = existsDatabase(dbPath)
tableExists = iif(dbExists, existsTable(dbPath, tableName), false)

if (!dbExists) {
    // Branch 1: DB doesn't exist — create new DB and table
    db = database(dbPath, VALUE, 2024.01.01..2025.12.31, engine="TSDB")
} else if (dbExists && !tableExists) {
    // Branch 2: DB exists, table doesn't — reuse DB
    db = database(dbPath)
} else {
    // Branch 3: DB exists, table exists — reuse both
    db = database(dbPath)
}

// Step 2: Preview and correct schema
schema = extractTextSchema("/data/stock_trades.csv")
update schema set type = `SYMBOL where name = "sym"

// Step 3: Import directly to database
loadTextEx(db, "trades", `date, "/data/stock_trades.csv",
           schema=schema, sortColumns=`sym`date)

// Step 4: Verify
pt = loadTable("dfs://stockDB", "trades")
select count(*) from pt
select top 10 * from pt
