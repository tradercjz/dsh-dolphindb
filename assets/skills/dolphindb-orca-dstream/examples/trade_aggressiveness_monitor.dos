// ============================================================
// Orca DStream API: 成交价相对盘口的主动性判断
// 1. 每笔成交按成交时间关联同股票最近一条盘口快照 (asof join)
// 2. TradePrice >= OfferPrice1 -> aggressiveBuy
//    TradePrice <= BidPrice1   -> aggressiveSell
//    否则                       -> neutral
// 3. 每股票每 30 秒统计主动买入额、主动卖出额、主动买入占比
//    并用 forceTriggerTime 在时间推进后强制结算未触发的窗口
// ============================================================

// -------------------------
// 1. Catalog
// -------------------------
if (!existsCatalog("orcaTradeDemo")) {
    createCatalog("orcaTradeDemo")
}
go
use catalog orcaTradeDemo

// -------------------------
// 2. 清理旧流图（调试用；生产环境勿随意清理上游真实流表）
// -------------------------
try { dropStreamGraph("tradeAggressiveness", true) } catch(ex) {}
go
sleep(1000)

// -------------------------
// 3. 自定义函数
// -------------------------
// 判断主动性并拆分主动买/卖金额
def classifyTrade(msg) {
    return select SecurityID, TradeTime, TradePrice, TradeQty, BidPrice1, OfferPrice1,
        iif(TradePrice >= OfferPrice1, "aggressiveBuy", iif(TradePrice <= BidPrice1, "aggressiveSell", "neutral")) as direction,
        iif(TradePrice >= OfferPrice1, TradePrice * TradeQty, 0.0) as aggressiveBuyAmt,
        iif(TradePrice <= BidPrice1, TradePrice * TradeQty, 0.0) as aggressiveSellAmt
    from msg
}

// 窗口聚合后计算主动买入占比
def calcRatio(msg) {
    return select *, aggressiveBuyAmount / (aggressiveBuyAmount + aggressiveSellAmount) as aggressiveBuyRatio from msg
}

// -------------------------
// 4. 构建流图（用中间变量承接每一步，避免前导点续行报错）
// -------------------------
g = createStreamGraph("tradeAggressiveness")

// 右流：盘口快照
snapSrc = g.source("snapshotStream", `SecurityID`SnapTime`BidPrice1`OfferPrice1, [SYMBOL, TIMESTAMP, DOUBLE, DOUBLE])

// 左流：逐笔成交
tradeSrc = g.source("tradeStream", `SecurityID`TradeTime`TradePrice`TradeQty, [SYMBOL, TIMESTAMP, DOUBLE, INT])

// 每笔成交关联时间不晚于它的最近一条快照
joined = tradeSrc.asofJoinEngine(
    rightStream = snapSrc,
    metrics = <[TradePrice, TradeQty, BidPrice1, OfferPrice1]>,
    matchingColumn = `SecurityID,
    timeColumn = [`TradeTime, `SnapTime],   // 左表/右表时间列名不同
    delayedTime = 1000)                      // 最多等 1 秒后触发关联输出

// 判断主动性
classified = joined.map(classifyTrade)

// 每股票每 30 秒聚合主动买/卖金额
agg = classified.timeSeriesEngine(
    windowSize = 30000,                      // 30 秒
    step = 30000,
    metrics = <[sum(aggressiveBuyAmt) as aggressiveBuyAmount, sum(aggressiveSellAmt) as aggressiveSellAmount]>,
    timeColumn = `TradeTime,
    useSystemTime = false,
    keyColumn = `SecurityID,
    forceTriggerTime = 30000)                // 窗口结束后时间线推进≥30s则强制结算

// 计算主动买入占比并输出
result = agg.map(calcRatio)
result.sink("aggressivenessStats")

g.submit()
sleep(3000)
getStreamGraphMeta("tradeAggressiveness").status   // 应为 running 或 building，稍后转 running

// -------------------------
// 5. Mock 数据（先写快照右表，再写成交左表）
// -------------------------
snap = table(
    [`A, `A, `B, `A, `B, `A, `B] as SecurityID,
    [2025.01.01T09:30:00.000, 2025.01.01T09:30:10.000, 2025.01.01T09:30:05.000,
     2025.01.01T09:30:25.000, 2025.01.01T09:30:20.000, 2025.01.01T09:30:40.000,
     2025.01.01T09:30:35.000] as SnapTime,
    [10.00, 10.02, 20.00, 10.05, 20.10, 10.10, 20.20] as BidPrice1,
    [10.02, 10.04, 20.05, 10.07, 20.15, 10.12, 20.25] as OfferPrice1)
appendOrcaStreamTable("snapshotStream", snap)
sleep(1000)

// 最后一笔 09:32:30 推进时间线，配合 forceTriggerTime 结算前面各窗口
trade = table(
    [`A, `A, `B, `A, `B, `A, `B, `A, `B, `A] as SecurityID,
    [2025.01.01T09:30:12.000, 2025.01.01T09:30:15.000, 2025.01.01T09:30:08.000,
     2025.01.01T09:30:30.000, 2025.01.01T09:30:22.000, 2025.01.01T09:30:45.000,
     2025.01.01T09:30:38.000, 2025.01.01T09:31:05.000, 2025.01.01T09:31:10.000,
     2025.01.01T09:32:30.000] as TradeTime,
    [10.05, 10.01, 20.00, 10.08, 20.12, 10.10, 20.18, 10.20, 20.30, 10.11] as TradePrice,
    [100, 200, 150, 300, 120, 80, 60, 90, 70, 10] as TradeQty)
appendOrcaStreamTable("tradeStream", trade)
sleep(3000)

// -------------------------
// 6. 查询结果
// -------------------------
select * from orcaTradeDemo.orca_table.aggressivenessStats order by SecurityID, TradeTime