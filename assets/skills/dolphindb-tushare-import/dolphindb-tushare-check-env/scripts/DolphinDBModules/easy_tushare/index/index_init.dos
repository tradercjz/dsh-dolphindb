module easy_tushare::index_init

/* 
*  @Brief: 指数数据历史数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use easy_tushare::index_create_table

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "easy_tushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: index_init_tables
*  @Brief: 初始化数据库表
*  @Param: table_names
*  @Return: None
*  @SampleUsage: index_init_tables(["index_basic"])
*/
def index_init_tables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "easy_tushare::index_create_table%"
        for(table in ts_create_tables){
            // table = 'easy_tushare::index_create_table::create_top_list'
            funcByName(table)()
        }
    } else {
        for (table_name in table_names){ 
            funcByName("easy_tushare::index_create_table::create_table_" + table_name)()
        }
    }
}

use easy_tushare::index_load_data

/*
*  @FunctionName: index_get_all_table_names
*  @Brief: 获取所有指数数据表名
*  @Param: None
*  @Return: list
*  @SampleUsage: index_get_all_table_names()
 */
def index_get_all_table_names(){
    ts_create_tables = exec name from defs() where name like "easy_tushare::index_load_data::append_%"
    return ts_create_tables.split("::")[2].substr(7)
}

/*
*  @FunctionName: append_idx_mink
*  @Brief: 指数分钟数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: append_idx_mink(token, start_date, end_date)
 */
def append_idx_mink(token, start_date, end_date,table_names = []) {
    if (size(table_names) == 0){
        // 1min
        append_idx_1min_k(token, start_date, end_date)
        // 5min
        append_idx_5min_k(token, start_date, end_date)
        // 15min
        append_idx_15min_k(token, start_date, end_date)
        // 30min
        append_idx_30min_k(token, start_date, end_date)
        // 60min
        append_idx_60min_k(token, start_date, end_date)
    } else {
        for (table_name in table_names){ 
            if (table_name == "idx_1min_k") {
                append_idx_1min_k(token, start_date, end_date)
            } else if (table_name == "idx_5min_k") {
                append_idx_5min_k(token, start_date, end_date)
            } else if (table_name == "idx_15min_k") {
                append_idx_15min_k(token, start_date, end_date)
            } else if (table_name == "idx_30min_k") {
                append_idx_30min_k(token, start_date, end_date)
            } else if (table_name == "idx_60min_k") {
                append_idx_60min_k(token, start_date, end_date)
            }
        }
    } 
}

/*
*  @FunctionName: index_history_data_load
*  @Brief: 指数数据历史数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: index_history_data_load(token,start_date,end_date)
*/
def index_history_data_load(token,start_date,end_date, table_names = []) {
    mink_tb_names = []
    // 本次需要导入的所有表名
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = index_get_all_table_names()        
    } else {
        all_table_names = table_names
    }
    for (table_name in all_table_names){ // table_name = "index_basic"
            
        if (table_name in ["idx_1min_k","idx_5min_k","idx_15min_k","idx_30min_k","idx_60min_k"]){
            mink_tb_names.append!(table_name)
        }  else {
            submitJob("append_" + table_name, "append_" + table_name, funcByName("easy_tushare::index_load_data::append_" + table_name), token, start_date, end_date)
        }
    }
    // 分钟K数据
    if (mink_tb_names.size() > 0){
        mink_start_date = max(2009.01.01,start_date)
        submitJob("append_idx_mink", "append_idx_mink", append_idx_mink, token, mink_start_date, end_date, mink_tb_names)
    }
}

