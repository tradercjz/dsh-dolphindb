module easy_tushare::fund_init

/* 
*  @Brief: 基金历史数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026-03-24 10:52:57
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use easy_tushare::fund_create_table

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "easy_tushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: fund_init
*  @Brief: 初始化数据库表
*  @Param: None
*  @Return: None
*  @SampleUsage: fund_init()
*/
def fund_init_tables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "easy_tushare::fund_create_table%"
        for(table in ts_create_tables){
            // table = 'easy_tushare::fund_create_table::create_top_list'
            funcByName(table)()
        }
    } else {
        for (table_name in table_names){ 
            funcByName("easy_tushare::fund_create_table::create_table_" + table_name)()
        }
    }
}

// 导入模块
use easy_tushare::fund_load_data


/*
*  @FunctionName: fund_get_all_table_names
*  @Brief: 获取所有基金数据表名
*  @Param: None
*  @Return: list
*  @SampleUsage: fund_get_all_table_names()
*/
def fund_get_all_table_names(){
    ts_create_tables = exec name from defs() where name like "easy_tushare::fund_load_data::append_%"
    return ts_create_tables.split("::")[2].substr(7)
}


/*
*  @FunctionName: fund_history_data_load
*  @Brief: 基金历史数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: fund_history_data_load(token,start_date,end_date)
*/
def fund_history_data_load(token,start_date,end_date,table_names=[]) { 
    // token = "xxx"
    // table_names = ["fund_basic"]
    // start_date = 2026.04.13
    // end_date = 2026.04.14
    // 使用submitJob提交所有数据更新任务，并行执行以提高效率
    // 数据起始日期（tushare接口可以返回的最早的数据日期）
    erlist_dates = dict(STRING,DATE)
    erlist_dates["fund_basic"] = 2000.01.01
    erlist_dates["fund_company"] = 2000.01.01
    erlist_dates["fund_div"] = 2000.01.01
    erlist_dates["fund_factor_pro"] = 2000.01.01
    erlist_dates["fund_manager"] = 2000.01.01
    erlist_dates["fund_nav"] = 2000.01.01
    erlist_dates["fund_portfolio"] = 2000.01.01
    erlist_dates["fund_share"] = 2000.01.01
    
    mink_tb_names = []
    fuquan_tb_names = []
    // 本次需要导入的所有表名
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = fund_get_all_table_names()        
    } else {
        all_table_names = table_names
    }
    for (table_name in all_table_names){ // table_name = "fund_basic"   
        get_start_date = erlist_dates[table_name]
        if (get_start_date==NULL) {
            get_start_date = start_date
        }
        submitJob("append_" + table_name, "append_" + table_name, funcByName("easy_tushare::fund_load_data::append_" + table_name), token, max(get_start_date,start_date), end_date)
    }
}
