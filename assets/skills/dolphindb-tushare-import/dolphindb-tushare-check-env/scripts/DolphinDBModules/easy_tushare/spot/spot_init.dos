module easy_tushare::spot_init

/* 
*  @Brief: 现货数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use easy_tushare::spot_create_table

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "easy_tushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: spot_init_tables
*  @Brief: 初始化数据库表
*  @Param: None
*  @Return: None
*  @SampleUsage: spot_init_tables()
*/
def spot_init_tables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "easy_tushare::spot_create_table%"
        for(table in ts_create_tables){
            // table = 'easy_tushare::spot_create_table::create_top_list'
            funcByName(table)()
        }
    } else {
        for (table_name in table_names){ 
            funcByName("easy_tushare::spot_create_table::create_" + table_name)()
        }
    }
}

use easy_tushare::spot_load_data
/*
*  @FunctionName: spot_get_all_table_names
*  @Brief: 获取所有现货数据表名
*  @Param: None
*  @Return: list
*  @SampleUsage: spot_get_all_table_names()
*/
def spot_get_all_table_names(){
    ts_create_tables = exec name from defs() where name like "easy_tushare::spot_load_data::append_%"
    return ts_create_tables.split("::")[2].substr(7)
}

/*
*  @FunctionName: spot_history_data_load
*  @Brief: 现货数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: spot_history_data_load(token,start_date,end_date)
*/
def spot_history_data_load(token,start_date,end_date,table_names = ALL) {
    // 本次需要导入的所有表名
    all_table_names = []
    if (table_names == "ALL"){
        all_table_names = spot_get_all_table_names()        
    } else {
        all_table_names = table_names
    }
    for (table_name in all_table_names){ // table_name = "1min_k"
        submitJob("append_" + table_name, "append_" + table_name, funcByName("easy_tushare::spot_load_data::append_" + table_name), token, start_date, end_date)
    }
}

