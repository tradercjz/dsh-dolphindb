module easy_tushare::llm_init

/* 
*  @Brief: 大模型语料历史数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use easy_tushare::llm_create_table

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "easy_tushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: llm_init_tables
*  @Brief: 初始化数据库表
*  @Param: table_names
*  @Return: None
*  @SampleUsage: llm_init_tables(["anns_d"])
*/
def llm_init_tables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "easy_tushare::llm_create_table%"
        for(table in ts_create_tables){
            // table = 'easy_tushare::llm_create_table::create_top_list'
            funcByName(table)()
        }
    } else {
        for (table_name in table_names){ 
            funcByName("easy_tushare::llm_create_table::create_table_" + table_name)()
        }
    }
}

use easy_tushare::llm_load_data

def llm_get_all_table_names(){
    ts_create_tables = exec name from defs() where name like "easy_tushare::llm_load_data::append_%"
    return ts_create_tables.split("::")[2].substr(7)
}

/*
*  @FunctionName: llm_history_data_load
*  @Brief: 大模型语料历史数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: llm_history_data_load(token,start_date,end_date)
*/
def llm_history_data_load(token,start_date,end_date,table_names = []) {
    // start_date = 2026.04.21
    // end_date = 2026.04.21
    earlist_date = dict(STRING,DATE) 
    earlist_date["major_news"] = 2018.09.28
    earlist_date["irm_qa_sh"] = 2023.06.01
    earlist_date["irm_qa_sz"] = 2010.10.01
    earlist_date["cctv_news"] = 2017.01.01
    earlist_date["research_report"] = 2017.01.01

    // 本次需要导入的所有表名
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = llm_get_all_table_names()        
    } else {
        all_table_names = table_names
    }
    for (table_name in all_table_names){ // table_name = "irm_qa_sh"
        final_start_date = earlist_date[table_name]
        if (final_start_date == NULL){
            final_start_date = start_date
        }
        submitJob("append_" + table_name, "append_" + table_name, funcByName("easy_tushare::llm_load_data::append_" + table_name), token, max(final_start_date, start_date), end_date)
    }
}

