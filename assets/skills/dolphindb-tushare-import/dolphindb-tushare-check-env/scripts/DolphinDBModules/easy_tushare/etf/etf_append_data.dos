*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: append_etf_stk_60_mins("your_token", 2025.01.01, 2025.02.01)   
*/
def append_etf_stk_60_mins(token, start_date1, end_date1){
    dbPath = "dfs://tushare_minute_db"
    tableName = "stk_60_mins"
    api = "etf_mins"
    cols = ["ts_code","trade_time","open","close","high","low","vol","amount"]
    out = loadTable(dbPath, tableName)
    
    // 示例ETF代码，实际使用时可能需要循环处理多个代码
    p = {"list_status":"L"}
    api1 = "etf_basic"
    etfCodes = exec ts_code from get_api_data(token, api1, p, cols)
    
    freq = "60min"
    days = start_date1..end_date1
    // days = 2009.01.01..end_date // 从2009年1月1日开始导入
    // days = 2026.03.10..2026.03.10 // 从2009年1月1日开始导入
    monthBeginDays = monthBegin(days).distinct().sort!()
    len = size(monthBeginDays)
    delete from out where date(trade_time) >= start_date1 and date(trade_time) <= end_date1
    for (i in 0..(len-1)) { // i=0
        start_day = temporalFormat(max(monthBeginDays[i], start_date), "yyyy-MM-dd")
        end_day = temporalFormat(min(monthEnd(monthBeginDays[i]), end_date), "yyyy-MM-dd")

        start_time = start_day + " 09:00:00"
        end_time = end_day + " 19:00:00"
        for(ts_code in etfCodes){
            
            p = {"ts_code":ts_code, "freq":freq, "start_date":start_time, "end_date":end_time}
            res = get_api_data(token, api, p, cols)

            if (!res.isVoid() and res.count() !=0){

                update res set update_time = now()

                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "trade_time", temporalParse(string(res.trade_time), "yyyy-MM-dd HH:mm:ss"))
                replaceColumn!(res, "open", double(res.open))
                replaceColumn!(res, "close", double(res.close))
                replaceColumn!(res, "high", double(res.high))
                replaceColumn!(res, "low", double(res.low))
                replaceColumn!(res, "vol", int(res.vol))
                replaceColumn!(res, "amount", double(res.amount))
                replaceColumn!(res, "update_time", timestamp(res.update_time))

                // 重命名 ts_code 为 code
                // renameColumn!(res, "ts_code", "code")

                out.append!(res)
                print("Success append data for Table " + api + " for code: " + ts_code)
            } else {
                print("no data for Table " + api + " for code: " + ts_code)
            }     
        }
    }
    print("Success append data for Table " + api)
}

