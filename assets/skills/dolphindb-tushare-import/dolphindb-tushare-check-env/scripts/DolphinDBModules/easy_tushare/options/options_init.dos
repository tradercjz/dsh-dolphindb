module easy_tushare::options_init

/* 
*  @Brief: 期权数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use easy_tushare::options_create_table

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "easy_tushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: options_init_tables
*  @Brief: 初始化数据库表
*  @Param: table_names
*  @Return: None
*  @SampleUsage: options_init_tables(["1min_k"])
**/
def options_init_tables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "easy_tushare::options_create_table%"
        for(table in ts_create_tables){
            // table = 'easy_tushare::options_create_table::create_top_list'
            funcByName(table)()
        }
    } else {
        for (table_name in table_names){ 
            funcByName("easy_tushare::options_create_table::create_" + table_name)()
        }
    }
}

use easy_tushare::options_load_data

/*
*  @FunctionName: options_get_all_table_names
*  @Brief: 获取所有期权数据表名
*  @Param: None
*  @Return: list
*  @SampleUsage: options_get_all_table_names()
*/
def options_get_all_table_names(){
    ts_create_tables = exec name from defs() where name like "easy_tushare::options_load_data::append_%"
    return ts_create_tables.split("::")[2].substr(7)
}

/**
*  @FunctionName: options_1_mink
*  @Brief: 期权1min_k数据导入函数 (先导入基础信息，再导入1min_k数据)
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: options_1_mink(token,start_date,end_date)
*/
def options_mink(token,table_names,start_date,end_date){
    // 先导入基础信息，再导入1min_k数据
    append_opt_basic(token, start_date, end_date)
    for (table_name in table_names){
        if (table_name == 'opt_1min_k'){
            append_opt_1min_k(token, start_date, end_date)
        } else if (table_name == 'opt_5min_k'){
            append_opt_5min_k(token, start_date, end_date)
        } else if (table_name == 'opt_15min_k'){
            append_opt_15min_k(token, start_date, end_date) 
        } else if (table_name == 'opt_30min_k'){
            append_opt_30min_k(token, start_date, end_date)
        } else if (table_name == 'opt_60min_k'){
            append_opt_60min_k(token, start_date, end_date) 
        }
    }
}

/*
*  @FunctionName: options_history_data_load
*  @Brief: 期权数据导入函数
*  @Param: token, start_date, end_date, table_names
*  @Return: None
*  @SampleUsage: options_history_data_load(token,start_date,end_date)
*/
def options_history_data_load(token,start_date,end_date,table_names = []) {
    // 本次需要导入的所有表名
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = options_get_all_table_names()        
    } else {
        all_table_names = table_names
    }
    min_k_tables = []
    for (table_name in all_table_names){
        if (table_name in ["opt_1min_k","opt_5min_k" ,"opt_10min_k" ,"opt_30min_k" ,"opt_60min_k"]){
            min_k_tables.append(table_name)
        }
    }
    
    if (size(min_k_tables) == 0 and ("opt_basic" in all_table_names)){
        submitJob("append_opt_basic", "append_opt_basic", append_opt_basic, token, start_date, end_date)
    }

    if ("opt_daily" in all_table_names){
        submitJob("append_opt_daily", "append_opt_daily", append_opt_daily, token, start_date, end_date)
    }

    if (size(min_k_tables) > 0){
        submitJob("options_mink", "options_mink", options_mink, token,min_k_tables, start_date, end_date)
    }
}

