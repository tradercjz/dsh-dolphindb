module easy_tushare::fx_schedulejob
/* 
*  @Brief: 外汇数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use easy_tushare::fx_load_data

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "easy_tushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

use easy_tushare::fx_init
/*
*  @FunctionName: load_fx_data_daily
*  @Brief: 外汇数据导入函数
*  @Param: token fx数据导入任务token
*  @Return: none
*  @SampleUsage: load_fx_data_daily(token)
*/
def load_fx_data_daily(token,table_names,funcDef){ 
    // 公共变量
    start_date = today()
    end_date = today()
    
    print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 开始执行tushare-外汇数据导入任务...")

    for (table_name in table_names){
        print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 开始导入" + table_name + "表...")
        func = funcDef[table_name]
        func(token, start_date, end_date)
        print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 结束导入" + table_name + "表")
    }

    print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 结束执行tushare-外汇数据导入任务")
}

/**
 * @FunctionName: scheduleJob_fx_data_daily
 * @Brief: 外汇数据导入任务
 * @Param: token fx数据导入任务token
 * @Return: none
 * @SampleUsage: scheduleJob_fx_data_daily(token)
 */
def scheduleJob_fx_data_daily(token,table_names = []){
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = fx_get_all_table_names()
    } else {
        all_table_names = table_names
    }
    // 构造函数引用字典，传递给scheduleJob
    funcDef = dict(STRING,ANY)
    for (table_name in all_table_names){
        funcDef[table_name] = funcByName("easy_tushare::fx_load_data::append_" + table_name)
    }
    scheduleJob("load_fx_data_daily","load_fx_data_daily",load_fx_data_daily{token,all_table_names,funcDef},20:00m,today(),2099.01.01,"D")  
}