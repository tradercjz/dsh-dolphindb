{
    "name": "sma",
    "desc": "在给定长度（以元素个数衡量）的滑动窗口内，计算 X 的简单移动平均， 返回和X相同长度的向量",
    "syntax": "sma(X, window)",
    "parameters": {
        "X": {
            "type": "VECTOR",
            "desc": "需要计算的数值型序列"
        },
        "window": {
            "type": "INT",
            "desc": "窗口长度"
        }
    },
    "results": {
        "result": {
            "type": "VECTOR",
            "desc": "按照window计算的简单移动平均"
        }
    },
    "example": [
        "sma(close, 5)"
    ]
}