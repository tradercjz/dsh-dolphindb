{
    "name": "rsi",
    "desc": "基于给定窗口长度，计算相对强弱指标，返回和输入序列相同长度的向量。",
    "syntax": "mytt::RSI(X, window)",
    "parameters": {
        "X": {
            "type": "VECTOR",
            "desc": "需要计算 RSI 的数值型序列，通常为收盘价序列"
        },
        "window": {
            "type": "INT",
            "desc": "RSI 的窗口长度"
        }
    },
    "results": {
        "result": {
            "type": "VECTOR",
            "desc": "按照 window 计算得到的 RSI 序列"
        }
    },
    "example": [
        "mytt::RSI(close, 14)"
    ]
}
